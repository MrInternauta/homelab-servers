# Immich — copy to `.env` and fill in. No real secrets in this file.

# Image tag (e.g. release or a pinned version like v1.120.0)
IMMICH_VERSION=release

# Postgres credentials (used by immich-db + immich-server)
# Generate a password with: openssl rand -hex 24
DB_USERNAME=immich
DB_PASSWORD=
DB_DATABASE_NAME=immich
