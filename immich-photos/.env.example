# Immich — copy to `.env` and fill in, or let ../configure.sh do both.
# No real secrets in this file.

# Image tag: `release`, or pin a version (e.g. v1.120.0) to control when a
# database migration happens.
IMMICH_VERSION=release

# Postgres credentials (used by immich-db and immich-server).
# Generate a password with: openssl rand -hex 24
DB_USERNAME=immich
DB_PASSWORD=
DB_DATABASE_NAME=immich

TZ=America/Mexico_City

# Parent of Images/ on the internal disk — mounted READ-ONLY into Immich.
MEDIA_ROOT=/Users/CHANGEME

# Mount point of the external/NAS volume (full path) — Immich's photo storage.
EXTERNAL_STORAGE=/Volumes/CHANGEME
