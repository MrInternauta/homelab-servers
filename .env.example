# ─────────────────────────────────────────────────────────────────────────────
# Home Lab — shared host configuration (macOS and Linux)
#
# Copy to `.env` and adjust, or let `./configure.sh` create and fill it for you.
# `configure.sh` copies these values into every service's own `.env`, which is
# what `docker compose` actually reads.
#
# NOTE: these are HOST paths, so they differ per OS. Always absolute, never
# trailing-slash.
# ─────────────────────────────────────────────────────────────────────────────

# Timezone applied to every container.
TZ=America/Mexico_City

# Host user/group the containers write files as.
#   macOS : first user is 501, group `staff` is 20
#   Linux : first user is usually 1000 / 1000
# Find yours with: id -u ; id -g
PUID=501
PGID=20

# Root of your LOCAL media, i.e. the parent of Audio/ Videos/ Images/ Documents.
#   macOS : /Users/<you>
#   Linux : /home/<you>          (or /srv/media on a headless box)
MEDIA_ROOT=/Users/CHANGEME

# Mount point of your EXTERNAL / NAS storage — a full path, not just a name.
#   macOS : /Volumes/<VolumeName>
#   Linux : /mnt/<name> or /srv/nas   (see SETUP.md § mounting on Linux)
EXTERNAL_STORAGE=/Volumes/CHANGEME

# Where every container keeps its own state (config, metadata, caches,
# databases), one sub-directory per service. Defaults to the external volume
# so the internal disk only holds the repo.
#   macOS : /Volumes/<VolumeName>/Storage
#   Linux : /mnt/<name>/Storage   (or a local disk such as /data/homelab)
# Leave empty and ./configure.sh fills it in as ${EXTERNAL_STORAGE}/Storage.
APPDATA_ROOT=

# Address `test-services.sh` probes the services on. Use your Tailscale IP or
# MagicDNS name for a true remote check; 127.0.0.1 for a local-only check.
SERVICE_HOST=127.0.0.1

# Stacks stack-guard.py leaves alone at boot, comma-separated (e.g. coolify).
STACK_GUARD_SKIP=
