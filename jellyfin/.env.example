# Jellyfin — copy to `.env`, or let ../configure.sh do it.
# No secrets here; these are host settings shared across the lab.

TZ=America/Mexico_City

# Host user/group the container writes as (macOS 501/20, Linux usually 1000/1000).
PUID=501
PGID=20

# Parent of Videos/ on the internal disk.
MEDIA_ROOT=/Users/CHANGEME

# Mount point of the external/NAS volume (full path).
EXTERNAL_STORAGE=/Volumes/CHANGEME

# Linux only, and only if you uncomment the hardware-transcoding block in
# docker-compose.yml: gid of the group that owns /dev/dri/renderD128.
#   getent group render | cut -d: -f3
# RENDER_GID=989
