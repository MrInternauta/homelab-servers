# Papra — copy to `.env` and fill in, or let ../configure.sh do both.
# No real secrets in this file.

# Session/auth signing secret. Generate one with: openssl rand -hex 32
AUTH_SECRET=password@123

TZ=America/Mexico_City

# The uid:gid the container runs as (`id -u` / `id -g`).
# macOS: 501/20 — Linux: usually 1000/1000.
PUID=501
PGID=20

# Parent of Documents/ on the internal disk.
MEDIA_ROOT=/Users/CHANGEME

# Mount point of the external/NAS volume (full path). Papra stores its data here.
EXTERNAL_STORAGE=/Volumes/CHANGEME
