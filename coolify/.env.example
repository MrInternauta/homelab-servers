# Coolify — copy to `.env` and fill in. No real secrets in this file.

# --- App ---
# APP_ID:  openssl rand -hex 16
# APP_KEY: base64:$(openssl rand -base64 32)
APP_ID=
APP_NAME=Coolify
APP_ENV=production
APP_KEY=
APP_PORT=8000

# --- Image source (defaults) ---
REGISTRY_URL=docker.io
LATEST_IMAGE=latest

# --- Postgres (coolify-db) ---
DB_DATABASE=coolify
DB_USERNAME=coolify
DB_PASSWORD=

# --- Redis (coolify-redis) ---
# openssl rand -hex 24
REDIS_PASSWORD=

# --- Realtime / Pusher (coolify-realtime / soketi) ---
# PUSHER_APP_ID: openssl rand -hex 16 ; KEY/SECRET: openssl rand -hex 24
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
SOKETI_PORT=6001
SOKETI_DEBUG=false
SOKETI_HOST=0.0.0.0
