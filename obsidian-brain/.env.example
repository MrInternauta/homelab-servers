# Obsidian — copy to `.env`, or let ../configure.sh do it.
# No secrets here; these are host settings shared across the lab.

TZ=America/Mexico_City

# Host user/group the container writes as (macOS 501/20, Linux usually 1000/1000).
# Keeping these aligned with your host user is what makes the vault editable
# from Finder / your file manager.
PUID=501
PGID=20
