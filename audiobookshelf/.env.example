# Audiobookshelf — copy to `.env`, or let ../configure.sh do it.
# No secrets here; these are host settings shared across the lab.

TZ=America/Mexico_City

# Host user/group the container writes as (macOS 501/20, Linux usually 1000/1000).
PUID=501
PGID=20

# Parent of Audio/ and Documents/ on the internal disk.
MEDIA_ROOT=/Users/CHANGEME

# Mount point of the external/NAS volume (full path).
EXTERNAL_STORAGE=/Volumes/CHANGEME

# Where this service keeps its state (config, caches, DB). Synced from the
# root .env by ../configure.sh — normally ${EXTERNAL_STORAGE}/Storage.
APPDATA_ROOT=/Volumes/CHANGEME/Storage
